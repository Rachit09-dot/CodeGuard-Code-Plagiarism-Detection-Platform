# ============================================================
# Code Plagiarism Detection Platform — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ---- Database -----------------------------------------------
# SQLite (local development, no Postgres required):
DATABASE_URL=sqlite:///./plagiarism.db

# PostgreSQL (Docker / production):
# DATABASE_URL=postgresql+psycopg2://plagiarism:plagiarism123@localhost:5432/plagiarism_db

# ---- Storage ------------------------------------------------
UPLOAD_DIR=./storage

# ---- CORS ---------------------------------------------------
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ---- Analysis algorithm ------------------------------------
# k-gram window size (number of tokens per gram)
K_GRAM_SIZE=5

# Winnowing window size
WINDOW_SIZE=12

# Default similarity threshold (0.0 – 1.0)
SIMILARITY_THRESHOLD=0.6

# Minimum token count for a submission to be considered "meaningful"
MIN_TOKENS_FOR_FINGERPRINT=5

# Combined score weights (must sum to 1.0)
TOKEN_WEIGHT=0.6
AST_WEIGHT=0.4

# ---- Upload limits -----------------------------------------
# Maximum file size in bytes (default 10 MB)
MAX_FILE_SIZE_BYTES=10485760
